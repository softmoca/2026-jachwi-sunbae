# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
# demo | naver (비우면 키 유무에 따라 자동 선택)
MAP_PROVIDER_MODE=
NAVER_MAP_CLIENT_ID=
API_BASE_URL=
# 로컬에서 dev API의 CORS 제한을 피하려면 https://dev-api.jachwi-sunbae.kr
# 개발 서버에서만 사용하며 배포 빌드에는 적용하지 않는다.
DEV_API_PROXY_TARGET=
ENABLE_MSW=false
# 개발 서버 포트. 비우면 3000을 쓴다. 3000이 이미 쓰이고 있을 때만 바꾼다.
PORT=
# dev와 prod는 같은 PostHog 프로젝트를 사용하고 environment 속성으로 구분한다.
# 로컬 수집이 필요할 때만 공개 프로젝트 토큰과 수집 호스트를 입력한다.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
