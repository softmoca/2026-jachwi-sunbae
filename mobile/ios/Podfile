# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
# Staging은 dev 서버를 보는 Release 빌드다. Pods는 Release 설정으로 빌드한다.
project 'JachwiSunbaeMobile', 'Debug' => :debug, 'Staging' => :release, 'Release' => :release
prepare_react_native_project!

# 기존 CocoaPods 빌드 경로를 유지한다. SPM과 Firebase를 중복 연결하지 않는다.
$RNFirebaseDisableSPM = true
$RNFirebaseAsStaticFramework = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'JachwiSunbaeMobile' do
  use_frameworks! :linkage => :static
  config = use_native_modules!

  # 앱 셸 전용 네이티브 UI(탭바 등)
  pod 'JachwiNativeUI', :path => './JachwiNativeUI'
  # 앱 셸 전용 네이티브 로그인(Apple, 카카오). 웹 auth 브리지가 쓴다.
  pod 'JachwiNativeAuth', :path => './JachwiNativeAuth'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27(iOS 27 SDK)은 배포 대상 15.0 미만을 오류로 막는다. 낮게 잡힌 Pod를 앱 최소 버전으로 올린다.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_configuration|
        current = build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current && Gem::Version.new(current) < Gem::Version.new(min_ios_version_supported)
          build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end
  end
end
