[Unit]
Description=Jachwi Sunbae backend lab
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=jachwi-lab
Group=jachwi-lab
WorkingDirectory=/opt/jachwi-lab
# root:root 0600 파일을 systemd가 읽은 후 실행 사용자에게 환경변수로 전달한다.
EnvironmentFile=/etc/jachwi-lab/app.env
# Amazon Linux 2023 ARM64의 Corretto 21 경로를 고정한다.
ExecStart=/usr/lib/jvm/java-21-amazon-corretto.aarch64/bin/java -jar /opt/jachwi-lab/app.jar --spring.profiles.active=lab --server.port=8080
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jachwi-lab
UMask=0027

[Install]
WantedBy=multi-user.target
