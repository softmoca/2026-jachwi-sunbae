# /etc/jachwi-lab/app.env에 복사한 뒤 실제 값으로 교체한다.
# systemd EnvironmentFile 형식: export, 명령 치환, 변수 참조를 사용하지 않는다.
# 값에 공백이나 특수문자가 있으면 작은따옴표로 감싼다. 실제 비밀값은 커밋하지 않는다.


DB_HOST=jachwi-sunbae-db.c30280sa2kfd.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=jachwi_sunbae
DB_SSL_MODE=REQUIRED
DB_USERNAME=jachwi_lab
DB_PASSWORD='REPLACE_WITH_DATABASE_PASSWORD'
JWT_SECRET='REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES'
CORS_ALLOWED_ORIGINS=http://localhost:3000

# lab 프로필과 8080 포트는 systemd ExecStart에서 지정한다.
# S3 리전·버킷·prefix와 비활성화 설정은 application-lab.yml을 사용한다.
# PHOTO_STORAGE_ENDPOINT/ACCESS_KEY/SECRET_KEY 및 AWS 정적 자격증명을 추가하지 않는다.
# MAP_*, *_ENABLED, SPRING_PROFILES_* 등 기존 dev/prod 환경변수를 복사하지 않는다.
